
params{

	reads=null
	runs=null
	reference=null
	gff=null
	outdir='results'
	help=false
	min_depth=10
	min_qual=30
	min_mapq=20
	min_baseq=20
	max_depth = 1000
	min_alt_fraction= 0.8
	max_ref_alt_fraction= 0.1

}


process{
	executor='local'
	cpus=1
	memory='1 GB'
	time= '1h'
	shell= ['/bin/bash', -'euo', 'pipefail']
	errorStrategy = 'terminate'
}

profiles {

	local {
		process.executor = 'local'
		executor.cpus=2
		executor.memory='4 GB'
		executor.queueSize =1
		process.maxForks=1
	}

	test {
        	params.reads = "${projectDir}/testdata/reads/*_{1,2}.fastq.gz"
        	params.reference = "${projectDir}/testdata/references/toy.fa"
        	params.outdir = "${projectDir}/results/test"
    }

	slurm{
		process.executor= 'slurm'
		process.queue = 'NEED_PARTITION_NAME'
		executor.queueSize = 4
		process{
			memory='4 GB'
			time='2h'
			withLabel: download{
				cpus=2
				memory='8 GB'
				time='8h'		
			}
			withLabel: align{
				cpus=4
				memory= '8 GB'
				time = '12h'
			}
			withLabel: annotation{
				memory='8 GB'
				time = '4h'
			}
		}
		
	}
}
